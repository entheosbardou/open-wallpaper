# Set both to long, unique passwords before starting the Compose stack.
DB_PASSWORD=replace-with-a-strong-application-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Optional Gallery integration. Leave unset unless using compose.gallery.yaml.
GALLERY_API_URL=https://gallery.example.com
GALLERY_CLIENT_INSTANCE=replace-with-a-unique-stable-instance-id
GALLERY_MEDIA_SOURCE=/path/to/gallery/media-root
GALLERY_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
OIDC_ISSUER=https://auth.example.com/application/o/open-wallpaper/
OIDC_CLIENT_ID=your-gallery-enabled-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_AUTO_PROVISION=0
PUBLIC_URL=https://live-wallpaper.example.com
