# Generate separate strong passwords; do not commit your .env file.
MYSQL_PASSWORD=replace-with-a-strong-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Optional read-only legacy wallpapers.files catalog (disabled by default)
EXTERNAL_CATALOG_ENABLED=false
EXTERNAL_CATALOG_URL=
EXTERNAL_CATALOG_MEDIA_ROOT=/app/data/media
